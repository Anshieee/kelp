# Compose interpolation variables for the KELP deployment (KEL-16, M2-F).
#
#   sudo install -m 0644 deploy/compose.env.example /opt/kelp/.env
#   sudo $EDITOR /opt/kelp/.env      # set KELP_IMAGE to the tag you built
#
# This file is read by `docker compose` itself and by the systemd unit's
# EnvironmentFile. It is NOT the container environment: nothing here is passed
# into the container. Secrets live in deploy/kelp.env, which Compose reads
# through its `env_file:` directive — keep the two files separate.
#
# No secret belongs in this file. It is committed as an example and lives at the
# repository root, inside the build context.

# The image tag to run. Required: docker-compose.yml has no default, so an
# unset or wrong value fails startup instead of building or pulling something.
# Replace the placeholder with the tag produced by docs/DEPLOY.md §4:
#   export TAG=$(git rev-parse --short HEAD)
#   KELP_IMAGE=kelp:$TAG
KELP_IMAGE=kelp:replace-me

# Host port for the loopback publish (the container always listens on 8765).
# Change only if 8765 is taken on the host; the reverse proxy then targets this
# port instead. The container port stays 8765.
KELP_PUBLISH_PORT=8765
