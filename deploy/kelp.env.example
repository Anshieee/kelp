# KELP runtime environment: copy to deploy/kelp.env, fill in, chmod 600.
#
# This file (not this example) is the only place secrets live on the host. It
# is gitignored and excluded from the build context; nothing here is baked into
# the image or printed by a probe. Paths are set by the image itself and are
# only overridden below if you mount `/data` somewhere unusual.
#
# This is the *container* environment, read by the Compose `env_file:`
# directive. It is not interpolated into docker-compose.yml, and it holds no
# deployment tag. The tag and host port live in `/opt/kelp/.env`, see
# deploy/compose.env.example.
#
# Every container variable in the docs/DEPLOY.md section 3 environment table
# appears here. A line beginning with `#` is optional and shows the value the
# image already uses; uncomment only what you need to change. The two required
# secrets have no default and must be filled in before the server will start.

# --- Required values --------------------------------------------------------
# Server-only model provider key. Never send it to a browser.
KELP_PROVIDER_API_KEY=
# OpenAI-compatible provider endpoint. Required; no default host is baked in.
# The documented example is https://openrouter.ai/api/v1, but any
# OpenAI-compatible service works. An unset endpoint is a typed
# `missing_base_url` failure, never a request to a vendor default.
KELP_PROVIDER_BASE_URL=
# Owner bearer token for /api/*. Long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KELP_AUTH_TOKEN=

# --- Optional provider identity (non-secret) --------------------------------
# Provider id used in records and admin rows. This build speaks the
# OpenAI-compatible API, so that is the default. A second provider changes this
# name and the endpoint above; it does not need a code fork.
# KELP_PROVIDER=openai-compatible

# --- Optional secrets -------------------------------------------------------
# Sent as X-CSRF-Token on bearer mutations. Unset falls back to the same-origin
# check for cookie sessions.
# KELP_CSRF_TOKEN=
# Server-side key for the HMAC-derived per-device CSRF half. Unset falls back
# to KELP_AUTH_TOKEN; set a dedicated long random value to rotate the two
# independently. It is never written to the database, logs, or audit trail.
# KELP_SESSION_SECRET=

# --- Owner sessions and auth lockout (non-secret) ---------------------------
# Session lifetime from last use, in seconds (30-day rolling; minimum 60).
# KELP_SESSION_TTL_SECONDS=2592000
# Maximum live device sessions; the oldest idle session is evicted.
# KELP_SESSION_MAX=1024
# 0 only for a loopback HTTP development run; keep 1 in production.
# KELP_SESSION_COOKIE_SECURE=1
# Failed auth attempts per hashed identity before a 429 lockout; 0 disables.
# KELP_AUTH_LOCKOUT_ATTEMPTS=10
# Lockout duration in seconds; emitted as Retry-After.
# KELP_AUTH_LOCKOUT_SECONDS=300
# Idle-out for an auth-failure record, and the bound on the hashed map.
# KELP_AUTH_FAILURE_IDLE_SECONDS=300
# KELP_AUTH_FAILURE_MAX_KEYS=4096

# --- Model roles and pricing (non-secret) ----------------------------------
# Model ids are provider-specific. The values below are the documented
# OpenRouter/Nemotron examples (kernel/providers/presets.py), not a
# requirement; replace them with the ids your endpoint serves.
KELP_PRIMARY_MODEL=nvidia/nemotron-3.5-super-vl
KELP_BACKGROUND_MODEL=nvidia/nemotron-3.5-lightning
# Optional USD-per-million override, merged over the example price table:
#   KELP_PRICING_JSON={"model-id":{"input_per_million":0.15,"output_per_million":0.50}}
# An unpriced model stays unpriced, which fails closed under a spend cap.
# KELP_PRICING_JSON=

# --- Process (non-secret) ---------------------------------------------------
# `info` | `debug` | `warning` | `error`
KELP_LOG_LEVEL=info
# Empty means the built-in skills shipped in the image.
# KELP_SKILL_ROOT=
# Installed plugin packages and plugins.lock.json. The image rootfs is
# read-only, so a container that installs plugins must use a /data path.
# KELP_PLUGIN_ROOT=/data/plugins
# 1 loads packages with no pin. Local experiments only; leave unset here.
# KELP_PLUGINS_ALLOW_UNPINNED=0

# --- Spend guardrails (non-secret) -----------------------------------------
# Unset means uncapped. Values are USD; windows are the UTC day and calendar
# month. The provider-side cap in docs/DEPLOY.md section 13.2 is separate.
# KELP_SPEND_CAP_DAY_USD=2.00
# KELP_SPEND_CAP_MONTH_USD=40.00
# What an unpriced turn means for the cap: `block` or `count_as`.
# KELP_SPEND_UNKNOWN_PRICE_MODE=block
# Amount charged per unpriced turn in `count_as` mode.
# KELP_SPEND_UNKNOWN_PRICE_USD=0.01

# --- Rate limits and concurrency (non-secret) ------------------------------
# 0 disables the token buckets; the concurrency caps stay on.
# KELP_RATE_LIMIT_ENABLED=1
# Per-minute allowance and burst capacity, per client identity.
# KELP_RATE_LIMIT_AUTH_RPM=30
# KELP_RATE_LIMIT_AUTH_BURST=10
# KELP_RATE_LIMIT_CHAT_RPM=120
# KELP_RATE_LIMIT_CHAT_BURST=30
# KELP_RATE_LIMIT_UPLOAD_RPM=60
# KELP_RATE_LIMIT_UPLOAD_BURST=20
# KELP_RATE_LIMIT_READ_RPM=600
# KELP_RATE_LIMIT_READ_BURST=200
# Metrics and readiness; keep this above the probe rate.
# KELP_RATE_LIMIT_ADMIN_RPM=1200
# KELP_RATE_LIMIT_ADMIN_BURST=300
# Anonymous share reads: per link, and the process-wide ceiling.
# KELP_RATE_LIMIT_SHARE_RPM=30
# KELP_RATE_LIMIT_SHARE_BURST=10
# KELP_RATE_LIMIT_SHARE_GLOBAL_RPM=600
# KELP_RATE_LIMIT_SHARE_GLOBAL_BURST=200
# Idle-out before a limiter key starts with a full bucket again.
# KELP_RATE_LIMIT_IDLE_SECONDS=300
# Bound on the number of distinct limiter keys held in memory.
# KELP_RATE_LIMIT_MAX_KEYS=4096
# Global cap on turns running at once; 0 disables.
# KELP_MAX_CONCURRENT_TURNS=4
# Concurrent SSE streams per owner, and process-wide for anonymous shares.
# KELP_MAX_STREAMS_PER_OWNER=3
# KELP_MAX_SHARE_STREAMS=16

# --- Scheduled and proactive turns (KEL-23, KEL-27) -------------------------
# 0 stores task files but keeps the ticker idle. Defaults shown.
# KELP_SCHEDULER_ENABLED=1
# KELP_SCHEDULER_TICK_SECONDS=30
# KELP_SCHEDULER_GRACE_SECONDS=3600
# Maximum task files the scheduler will hold; over the cap is refused.
# KELP_SCHEDULER_MAX_TASKS=200
# Proactive runs in flight / per rolling hour; over either is a recorded skip.
# KELP_PROACTIVE_MAX_CONCURRENT=1
# KELP_PROACTIVE_MAX_RUNS_PER_HOUR=5
# Consecutive failed turns before that schedule is parked disabled.
# KELP_PROACTIVE_FAILURE_LIMIT=3

# --- State layout (defaults shown; the image already sets these) ------------
# KELP_HOST=0.0.0.0
# KELP_PORT=8765
# KELP_DB_PATH=/data/chat.db
# KELP_WORKSPACE_ROOT=/data/workspace
# KELP_ARTIFACT_DIR=/data/workspace/var/artifacts
# KELP_AUDIT_DIR=/data/audit
# KELP_USAGE_DIR=/data/usage

# --- Retention (defaults shown; see docs/DEPLOY.md section 8.1) -------------
# Audit and usage segment TTL in days, and their count caps.
# KELP_RETENTION_AUDIT_DAYS=30
# KELP_RETENTION_AUDIT_KEEP=40
# KELP_RETENTION_USAGE_DAYS=90
# KELP_RETENTION_USAGE_KEEP=100
# Grace before an unclaimed upload or unreferenced file is swept.
# KELP_RETENTION_ORPHAN_SECONDS=3600
# Active audit/usage file size that forces a rotation.
# KELP_RETENTION_LOG_MAX_BYTES=10485760
# Maximum segment interval for audit and usage records.
# KELP_RETENTION_LOG_ROTATE_SECONDS=86400
# Orphan-sweep, share-sweep, and rotation cadence after boot.
# KELP_RETENTION_INTERVAL_SECONDS=86400

# --- Share links (defaults shown) ------------------------------------------
# Default and maximum share lifetime; the hard ceiling wins.
# KELP_SHARE_TTL_SECONDS=604800
# KELP_SHARE_MAX_TTL_SECONDS=2592000
# Share snapshot cap; a larger thread is refused, not truncated.
# KELP_SHARE_MAX_SNAPSHOT_BYTES=4194304

# --- Release identity (optional; the image sets these at build time) --------
# Override only to label a hand-run container. Normally the Dockerfile build
# args are the source; see docs/DEPLOY.md section 4.
# KELP_VERSION=0.0.0
# KELP_GIT_COMMIT=

# Optional credential handoffs/vault; keep these values server-side.
# KELP_CREDENTIALS_ENABLED=1
# KELP_VAULT_KEY=
# KELP_BROWSER_WORKER_TOKEN=
# KELP_BROWSER_ALLOWED_ORIGINS=https://github.com
