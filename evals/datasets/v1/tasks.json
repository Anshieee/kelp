{
  "dataset_version": "1.0.0",
  "created": "2026-10-30",
  "description": "KEL-15 M2-E offline evaluation set: retrieval correctness, tool selection, approval gate behaviour, restart/resume invariants, and multi-turn continuity. Every task is deterministic and local; live mode replaces only the provider.",
  "tasks": [
    {
      "id": "EV-001",
      "category": "retrieval",
      "scenario": "retrieval",
      "name": "CSV total revenue with row citations",
      "prompt": "What is the total revenue across all regions?",
      "artifact_token": "evalretrieval001",
      "doc": {
        "kind": "csv",
        "filename": "sales_q3.csv",
        "content": "region,product,units,revenue\nNorth,GPU cluster,12,48000\nSouth,Storage tier,30,15000\nEast,Inference API,20,64000\nWest,Support plan,7,9000\n"
      },
      "expect": {
        "artifact_kind": "csv",
        "answer_contains": ["136,000"],
        "citation_locators": ["row 2", "row 3", "row 4", "row 5"]
      }
    },
    {
      "id": "EV-002",
      "category": "retrieval",
      "scenario": "retrieval",
