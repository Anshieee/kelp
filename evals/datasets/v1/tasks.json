    {
      "id": "EV-008",
      "category": "tool",
      "scenario": "tool_turn",
      "name": "Selects web.search with a fresh query",
      "prompt": "Search the web for the latest Nebius GPU pricing.",
      "fixture": "provider_v1",
      "expect": {
        "tool_calls": [
          {
            "name": "web.search",
            "arguments": {
              "query": "latest Nebius GPU pricing",
              "max_results": 5,
              "freshness": "week"
            }
          }
        ],
        "final_contains": ["latest Nebius GPU pricing"]
      }
    },
    {
      "id": "EV-009",
