    {
      "id": "EV-014",
      "category": "approval",
      "scenario": "approval_approve",
      "name": "Approve runs a write tool exactly once",
      "prompt": "Schedule a weekday summary every morning at 8am.",
      "fixture": "provider_v1",
      "expect": {
        "tool_calls": [
          {
            "name": "schedule.create",
            "arguments": {
              "title": "Weekday summary",
              "prompt": "Summarize open issues each weekday morning.",
              "schedule": {"kind": "cron", "expr": "0 8 * * 1-5"},
              "timezone": "Europe/Berlin"
            }
          }
        ],
        "approval": {
          "decision": "approve",
          "status": "consumed",
          "executions": 1,
          "effects": ["write"]
        }
      }
    },
    {
      "id": "EV-015",
      "category": "approval",
      "scenario": "approval_deny",
      "name": "Deny blocks the handler and closes the card",
      "prompt": "Schedule a nightly digest.",
      "fixture": "provider_v1",
      "expect": {
        "tool_calls": [
          {
            "name": "schedule.create",
            "arguments": {
              "title": "Nightly digest",
              "prompt": "Summarize the day.",
              "schedule": {"kind": "cron", "expr": "0 22 * * *"},
              "timezone": "UTC"
            }
          }
        ],
        "approval": {
          "decision": "deny",
          "status": "denied",
          "executions": 0,
          "effects": ["write"]
        }
      }
    },
    {
      "id": "EV-016",
      "category": "approval",
      "scenario": "approval_redaction",
      "name": "Approval cards never echo a configured secret",
      "prompt": "Schedule a task using eval-sentinel-1234 without showing it.",
      "fixture": "provider_v1",
      "secret_sentinel": "eval-sentinel-1234",
      "expect": {
        "approval": {
          "decision": "deny",
          "status": "denied",
          "executions": 0,
          "effects": ["write"],
          "secret_absent": "eval-sentinel-1234"
        }
      }
    },
    {
      "id": "EV-017",
      "category": "approval",
      "scenario": "approval_expired",
      "name": "An expired approval cannot be approved",
      "prompt": "Approve a card that has passed its expiry.",
      "expect": {
        "approval": {
          "decision": "approve",
          "status": "expired",
          "executions": 0
        }
      }
    },
    {
      "id": "EV-018",
      "category": "approval",
      "scenario": "approval_replay",
      "name": "A consumed approval cannot be replayed",
      "prompt": "Schedule a digest and then replay the approval.",
      "fixture": "provider_v1",
      "expect": {
        "tool_calls": [
          {
            "name": "schedule.create",
            "arguments": {
              "title": "Replay digest",
              "prompt": "Summarize the day twice?",
              "schedule": {"kind": "cron", "expr": "0 9 * * *"},
              "timezone": "UTC"
            }
          }
        ],
        "approval": {
          "decision": "approve",
          "status": "consumed",
          "executions": 1,
          "effects": ["write"],
          "replay_code": "already_used"
        }
      }
    },
    {
      "id": "EV-019",
      "category": "restart_resume",
      "scenario": "recovery_running_turn",
      "name": "Boot recovery closes a running turn as interrupted",
      "prompt": "Simulate a process crash mid-turn.",
      "expect": {
        "recovery": {
          "closed_turns": 1,
          "message_status": "interrupted",
          "turn_reason": "interrupted",
          "usage_persisted": false
        }
      }
    },
    {
      "id": "EV-020",
      "category": "restart_resume",
      "scenario": "recovery_running_tools_and_approval",
      "name": "Boot recovery fails running tools and expires approvals",
      "prompt": "Simulate a crash with an in-flight tool and a pending approval.",
      "expect": {
        "recovery": {
          "failed_tool_calls": 1,
          "expired_approvals": 1,
          "tool_status": "failed",
          "tool_error": "interrupted",
          "approval_status": "expired",
          "events": ["turn_finished", "approval_resolved"]
        }
      }
    },
    {
      "id": "EV-021",
      "category": "restart_resume",
      "scenario": "recovery_idempotent",
      "name": "Boot recovery is idempotent on a second boot",
      "prompt": "Run recovery twice against the same database.",
      "expect": {
        "recovery": {
          "second_closed_turns": 0,
          "second_failed_tool_calls": 0,
          "second_expired_approvals": 0,
          "single_turn_finished": true,
          "single_approval_resolved": true
        }
      }
    },
    {
      "id": "EV-022",
      "category": "restart_resume",
      "scenario": "resume_retry",
      "name": "Resume reuses the user message and supersedes the failed answer",
      "prompt": "Explain the deploy plan.",
      "fixture": "provider_v1",
      "expect": {
        "assistant_contains": ["Recovered answer"],
        "retry": {"same_user_message": true, "superseded": true, "provider_requests": 2}
      }
    },
    {
