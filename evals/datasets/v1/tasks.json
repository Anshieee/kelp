      "expect": {
        "assistant_contains": ["One answer"],
        "message_count": 2,
        "provider_requests": 1,
        "idempotent": true
      }
    },
    {
      "id": "EV-025",
      "category": "multi_turn",
      "scenario": "multi_turn_isolation",
      "name": "Two threads keep separate histories",
