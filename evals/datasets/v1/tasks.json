    {
      "id": "EV-012",
      "category": "tool",
      "scenario": "tool_turn",
      "name": "Chooses two tools for a two-part request",
      "prompt": "Search the web for Postgres 17 release notes and read the README from Anshieee/kelp.",
      "fixture": "provider_v1",
      "expect": {
        "tool_calls": [
          {
            "name": "web.search",
            "arguments": {
              "query": "Postgres 17 release notes"
