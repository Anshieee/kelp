      "followup": "beta",
      "fixture": "provider_v1",
      "expect": {
        "assistant_contains": ["Alpha answer"],
        "followup_contains": ["Beta answer"],
        "message_count": 2,
        "provider_requests": 2
      }
    },
    {
      "id": "EV-026",
      "category": "multi_turn",
      "scenario": "multi_turn_title",
      "name": "A follow-up does not overwrite the auto title",
      "prompt": "Draft the weekly report",
      "followup": "Make it shorter",
      "fixture": "provider_v1",
      "expect": {
        "assistant_contains": ["Draft ready"],
