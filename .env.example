# Copy to .env and fill in. .env is gitignored; this file never holds values.
# Server-only secrets. Never expose these to the browser bundle.

# --- Kernel / Nebius Token Factory (KEL-6) ---
NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
KELP_PRIMARY_MODEL=nvidia/Nemotron-3_5-Super-VL
KELP_BACKGROUND_MODEL=nvidia/Nemotron-3_5-Lightning

# --- Chat server (KEL-11, `make serve` / `python -m chat.server`) ---
# The single-process lock is taken on "<KELP_DB_PATH>.lock"; a second server
# fails with `database_locked` rather than opening the same database.
KELP_DB_PATH=var/chat.db
# Uploaded PDF/CSV content, the append-only KELP audit log, and per-turn usage
# records. Directories are created owner-only (0700).
KELP_ARTIFACT_DIR=var/workspace/var/artifacts
KELP_AUDIT_DIR=var/audit
KELP_USAGE_DIR=var/usage
# Tool workspace. Skills may only touch paths under ${WORKSPACE}/.
KELP_WORKSPACE_ROOT=var/workspace
# Bind address and port. Keep 127.0.0.1 unless a reverse proxy terminates TLS.
KELP_HOST=127.0.0.1
KELP_PORT=8765
# Root owner bearer token for /api/* (required; use a long random value). It
# also mints a 30-day rolling, HttpOnly session cookie; device sessions persist
# in the chat database across restarts. Optional static CSRF token for
# bearer-token mutations; cookie mutations use a per-session double-submit pair.
KELP_AUTH_TOKEN=
KELP_CSRF_TOKEN=
# Server-side key for the HMAC-derived per-device CSRF half. Unset falls back
# to KELP_AUTH_TOKEN, so set a dedicated long random value to rotate the two
# independently. It is never written to the database, logs, or audit trail.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
KELP_SESSION_SECRET=
KELP_SESSION_TTL_SECONDS=2592000
KELP_SESSION_MAX=1024
# Keep 1 in production; 0 only for a loopback HTTP development run.
KELP_SESSION_COOKIE_SECURE=1
KELP_AUTH_LOCKOUT_ATTEMPTS=10
KELP_AUTH_LOCKOUT_SECONDS=300
KELP_AUTH_FAILURE_IDLE_SECONDS=300
KELP_AUTH_FAILURE_MAX_KEYS=4096
# Optional custom skill root; empty means the built-in skills.
KELP_SKILL_ROOT=

# --- Scheduled and proactive turns (KEL-23, KEL-27) ---
# 0 keeps schedule task files stored but stops the ticker from firing them.
KELP_SCHEDULER_ENABLED=1
KELP_SCHEDULER_TICK_SECONDS=30
KELP_SCHEDULER_GRACE_SECONDS=3600
# Proactive runs allowed in flight at once, and starts per rolling hour. Over
# either bound is a recorded skip, never a queue.
KELP_PROACTIVE_MAX_CONCURRENT=1
KELP_PROACTIVE_MAX_RUNS_PER_HOUR=5
# Consecutive failed proactive turns before that one schedule is parked
# disabled; a clean turn resets the count.
KELP_PROACTIVE_FAILURE_LIMIT=3
