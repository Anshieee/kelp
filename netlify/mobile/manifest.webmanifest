{
  "id": "/mobile/",
  "name": "Kelp Mobile Workspace",
  "short_name": "Kelp",
  "description": "Review and approve repository changes from your phone.",
  "start_url": "/mobile/",
  "scope": "/mobile/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#141414",
  "theme_color": "#141414",
  "icons": [
    { "src": "/mobile/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/mobile/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/mobile/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/mobile/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ]
}
