{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kelp.local/schemas/skill-manifest-1.0.json",
  "title": "Skill manifest (v1.0)",
  "description": "Meta-schema for every skill manifest. Cross-field rules (approval, scopes grammar, entry resolution) are enforced by skills/loader.py; see docs/SKILL_SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "name",
    "version",
    "description",
    "triggers",
    "tools",
    "input_schema",
    "output_schema",
    "permissions",
    "entry",
    "timeout_ms",
    "idempotent",
    "cost_class"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}(\\.[a-z][a-z0-9_]{1,31})+$",
      "maxLength": 96
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.]+)?(\\+[0-9A-Za-z.]+)?$",
      "maxLength": 48
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description"],
        "properties": {
          "kind": {
            "enum": ["model", "schedule", "manual", "event"]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "examples": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,31}(\\.[a-z][a-z0-9_]{1,31})+$",
        "maxLength": 96
      }
    },
    "input_schema": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "object"
        }
      }
    },
    "output_schema": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "object"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effects", "scopes", "requires_approval", "secrets"],
      "properties": {
        "effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["read", "write", "network", "execute"]
          }
        },
        "scopes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "hosts", "repos"],
          "properties": {
            "paths": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "hosts": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 3,
                "maxLength": 253
              }
            },
            "repos": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "requires_approval": {
          "type": "boolean"
        },
        "secrets": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callable"],
      "description": "Built-in skills reference an importable 'module'; installed plugins MUST use a package-relative 'path' instead (KEL-25).",
      "anyOf": [
        { "required": ["module"] },
        { "required": ["path"] }
      ],
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "maxLength": 200
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,200}$",
          "maxLength": 200,
          "description": "POSIX path inside the plugin package, e.g. 'handler.py'. No absolute paths, '..' segments, or backslashes."
        },
        "callable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 600000
    },
    "idempotent": {
      "type": "boolean"
    },
    "cost_class": {
      "enum": ["free", "metered", "expensive"]
    }
  }
}
