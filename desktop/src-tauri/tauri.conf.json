{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kelp",
  "version": "0.1.0",
  "identifier": "ai.kelp.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kelp",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600
      },
      {
        "label": "pet",
        "url": "pet.html",
        "title": "Kelp pet",
        "width": 148,
        "height": 148,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "store": {},
    "stronghold": {},
    "updater": {
      "active": false
    }
  }
}
